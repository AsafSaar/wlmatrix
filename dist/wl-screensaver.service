[Unit]
Description=Wayland-native screensaver (wlmatrix via Mutter idle detection)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-0
# Idle time, fps, colors, etc. live in ~/.config/wlmatrix/config.toml.
# Optional overrides (uncomment to force, ignoring the config file):
# Environment=SAVER_IDLE_MS=300000
# Environment=SAVER_CMD=%h/.local/bin/wlmatrix --color amber
ExecStart=%h/.local/bin/wl-screensaver
Restart=on-failure

[Install]
WantedBy=graphical-session.target
